@startuml
title Отдача команд, контроль их исполнения - Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

System_Ext(remotecontrol, "Remote control", "Устройства дистанционного управления")

Container_Boundary(CommandService, "CommandService") {
  Container(CommandServ, "CommandService", "Java, Spring", "Отдача команд, контроль их исполнения")
  
}

Container(CommandServ, "Web Application", "Java, Spring") {
  Component(CommandController, "CommandController", "Управляет отдачей и исполнением команд")
  Component(CommandDriver, "DeviceDriver", "Взаимодействует с устройством по командам")
  Component(ServiceLayer, "Service Layer", "Business logic")
  Component(RepositoryLayer, "Repository Layer", "Логика доступа к данным")
}
Container(APIGateway, "APIGateway", "AGW", "Маршрутизация запросов к API")
Container(CommandDB, "DeviceDB", "MongoDB", "Хранилище конфигурационных данных устройств")
Rel(CommandController,ServiceLayer,"Обращается к логике исполнения команд")
Rel(ServiceLayer,CommandDriver,"Взаимодействует с устройством")
Rel(ServiceLayer,RepositoryLayer,"Чтение-запись данных")
Rel(RepositoryLayer,CommandDB,"Транзакционный доступ к данным")
Rel(CommandDriver,remotecontrol,"Взаимодействует с устройством")
Rel(APIGateway,CommandController,"Команды устройству", "asinc")

@enduml